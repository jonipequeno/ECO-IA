# =====================================================================
# Movili Tecnologia - variaveis de ambiente (todas opcionais).
# Copie para .env e ajuste. Os valores aqui sobrescrevem config/modelos.yaml.
# =====================================================================

# --- Backends de modelo ---------------------------------------------
MOVILI_OLLAMA_URL=http://localhost:11434
MOVILI_LMSTUDIO_URL=http://localhost:1234/v1

# Backend usado por todos os agentes: ollama | lmstudio | simulado
MOVILI_BACKEND_PADRAO=ollama

# Modelo usado por todos os agentes (sobrescreve o roteamento por agente)
MOVILI_MODELO_PADRAO=qwen3:8b

# Tempo maximo, em segundos, de cada chamada ao modelo
MOVILI_TIMEOUT=300

# --- Memoria semantica (RAG sobre o que a empresa ja produziu) --------
# "0" desliga; o ecossistema roda igual, so sem lembrar de projetos anteriores
MOVILI_EMBEDDINGS=1
MOVILI_MODELO_EMBEDDING=nomic-embed-text

# --- Armazenamento ---------------------------------------------------
MOVILI_DB=data/movili.db
MOVILI_WORKSPACE=workspace

# --- Obsidian ----------------------------------------------------------
# Pasta do cofre: projetos viram notas em Movili/, e as suas notas fora dela
# entram na memoria com 'movili obsidian indexar'. Vazio desliga.
MOVILI_OBSIDIAN=obsidian

# --- OpenJarvis (voz) ------------------------------------------------
# Voz do Piper para TTS em portugues do Brasil
MOVILI_VOZ_PIPER=pt_BR-faber-medium
# Voz do comando 'say' no macOS
MOVILI_VOZ_SAY=Luciana
# Tamanho do modelo Whisper para transcricao: tiny | base | small | medium
MOVILI_WHISPER=small
# Caminho do modelo .bin quando usar whisper.cpp em vez de faster-whisper
MOVILI_WHISPER_CPP_MODEL=
